{
    "liveServer.settings.port": 5501,
    // O Live Server recarrega a página quando QUALQUER arquivo da pasta muda.
    // O backend grava no banco (sinaliza.db) a cada tradução salva no histórico,
    // e isso recarregava o app no meio do uso. Só o front-end deve disparar reload.
    "liveServer.settings.ignoreFiles": [
        ".vscode/**",
        "**/backend/**",
        "**/*.db",
        "**/*.db-journal",
        "**/dados/**",
        "**/tools/**",
        "**/__pycache__/**",
        "**/.venv/**"
    ]
}
