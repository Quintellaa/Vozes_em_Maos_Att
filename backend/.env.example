# Copie este arquivo para .env e preencha os valores.
DATABASE_URL=sqlite:///./sinaliza.db
JWT_SECRET_KEY=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:5501","http://127.0.0.1:5501"]
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
MODEL_PATH=models/libras_pose_hands.joblib

# ---- E-mail do "Esqueci a senha" ----
# Sem nada configurado, o link de redefinição aparece no terminal do backend (bom para testar).
# Endereço do site que vai no link do e-mail (vazio = o endereço por onde a pessoa pediu).
APP_URL=
# Remetente (tem que estar liberado no serviço de envio escolhido abaixo).
MAIL_FROM=
MAIL_FROM_NAME=Vozes em Mãos
# Opção 1 — Mailjet (mailjet.com, grátis até 200 e-mails/dia). Funciona no plano grátis do Render.
# As chaves ficam no painel da Mailjet em "API Key Management". MAIL_FROM precisa estar confirmado lá.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Opção 2 — Brevo (brevo.com, grátis até 300 e-mails/dia). Também funciona no Render.
BREVO_API_KEY=
# Opção 3 — SMTP (não funciona no plano grátis do Render). Ex. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=seu@gmail.com e SMTP_PASSWORD=uma "senha de app" (não a senha normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
